# Dependencies
node_modules/
.pnpm-store/
.pnp.*
.yarn/*

# Build output
dist/
build/
out/
*.tsbuildinfo

# Exception: the notes-ui example ships a hand-written `web/dist` as a COMMITTED static fixture (the
# frontend-serving example serves + tests it). It is an example asset, not build output — re-include it.
!examples/notes-ui/web/dist/
!examples/notes-ui/web/dist/**

# Stray in-place-compiled `.js` inside an example extension-pack SOURCE root: packs are authored in
# `.ts` and built to `dist/`, but the compiled-module pack resolution prefers a sibling `.js` over the
# `.ts`, so an accidental in-place `tsc` output would shadow the source. Ignore it — no pack commits a
# `.js` under its source root (build output goes to `dist/`, already ignored above).
examples/**/packs/**/*.js

# The release identity manifest is generated per release run by scripts/release-identity.mjs and
# ships inside the launcher tarball. It records the commit it was generated at, so committing it
# would make it name its own parent commit and be stale the moment it lands.
packages/app/rayspec/rayspec-release-identity.json

# The packed release closure. The `//release-identity` operator sequence packs the 29 tarballs
# into release/v<version>/ before generating the manifest from them; they are build output.
release/

# The spec `docs/getting-started.md` walks you through authoring: it says to create `rayspec.yaml` in
# the repo root, so a reader following that page inside their own clone would otherwise carry an
# untracked file from then on. Every other artefact those docs ask for (`.env`, each `dist/`,
# `release/`) is already ignored; this closes the last one. The examples keep their own committed
# specs — those live under `examples/` with their own names and are unaffected.
/rayspec.yaml

# Caches
.turbo/
.cache/
coverage/
.vitest/

# Dev-harness scratch (throwaway blob store written by example dev-boot scripts)
.dev-blobs/

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*-key.txt
openai-key.txt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# IDE / OS
.DS_Store
.idea/
.vscode/
