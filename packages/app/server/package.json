{
  "name": "@rayspec/server",
  "version": "1.8.0",
  "private": true,
  "files": [
    "dist"
  ],
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayspec-labs/rayspec.git",
    "directory": "packages/app/server"
  },
  "type": "module",
  "description": "LOCAL/single-node production-style boot entrypoint + AppDeps composition root. Pre-external-hardening (no KMS/per-tenant isolate/DPoP; database roles and row-level security opt-in) — NOT internet-facing. Assembles the platform from env, applies the committed migration chain via the real programmatic migrator, fails closed on missing secrets, and serves the Hono app.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-tracing": {
      "types": "./dist/agent-tracing.d.ts",
      "default": "./dist/agent-tracing.js"
    },
    "./boot-env": {
      "types": "./dist/boot-env-demands.d.ts",
      "default": "./dist/boot-env-demands.js"
    },
    "./supervisor-handoff": {
      "types": "./dist/supervisor-handoff.d.ts",
      "default": "./dist/supervisor-handoff.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rayspec-serve": "./dist/serve.js"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "tsx src/serve.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@openai/agents": "0.11.8",
    "@rayspec/adapter-anthropic": "workspace:*",
    "@rayspec/adapter-codex": "workspace:*",
    "@rayspec/adapter-openai": "workspace:*",
    "@rayspec/adapter-pi": "workspace:*",
    "@rayspec/agent-runtime": "workspace:*",
    "@rayspec/api-auth": "workspace:*",
    "@rayspec/audio-runtime": "workspace:*",
    "@rayspec/auth-core": "workspace:*",
    "@rayspec/bundle": "workspace:*",
    "@rayspec/bundle-closure": "workspace:*",
    "@rayspec/bundle-contract": "workspace:*",
    "@rayspec/capability-bridges": "workspace:*",
    "@rayspec/conversation-runtime": "workspace:*",
    "@rayspec/core": "workspace:*",
    "@rayspec/db": "workspace:*",
    "@rayspec/durable-dbos": "workspace:*",
    "@rayspec/platform": "workspace:*",
    "@rayspec/product-yaml": "workspace:*",
    "@rayspec/spec": "workspace:*",
    "@rayspec/adapter-deepgram": "workspace:*",
    "@rayspec/adapter-openai-tts": "workspace:*",
    "@rayspec/stt-port": "workspace:*",
    "@rayspec/tts-port": "workspace:*",
    "age-encryption": "0.3.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.9",
    "jose": "6.2.3",
    "undici": "8.11.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "cctv-age": "0.2.0",
    "dotenv": "17.4.2",
    "postgres": "3.4.9",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
